# --- Locally (the network from GHCR; `make dev` builds it from ../pouw-*) ---
COMPOSE_PROFILES=
# COMPOSE_PROFILES=jenkins       # also Jenkins at http://localhost:8080 (admin / .secrets/jenkins_admin_password)
# JENKINS_LOCAL_BRANCH=main      # pouw-deploy branch tested by the local Jenkins
# COMPOSE_PROFILES=network       # also services without an image in GHCR yet (none right now);
#                                # `make dev` adds it itself and builds them from ../pouw-*
# HASURA_PORT=8081               # Hasura (GraphQL) on http://localhost:8081
# INDEXER_PORT=8083              # indexer API on http://localhost:8083
# DASHBOARD_PORT=8082            # explorer on http://localhost:8082
# ALERTMANAGER_PORT=9093         # Alertmanager (alerts, silences) on http://localhost:9093
# COMPOSE_PROFILES=host-metrics  # also node-exporter and cAdvisor (metrics of Docker's VM on macOS/Windows)
#
# The devnet (README → The devnet). Defaults: the reward of node-1 goes to the
# test key of the contracts, node-2 and node-3 dial node-1
# NODE_MINER_ADDRESS=addr:<64 hex>
# NODE_BOOTNODES=/dns4/node-1/tcp/30333
#
# Service image tags (default :main from GHCR; `make dev` and IMAGE_TAG use local builds)
# NODE_VERSION=main
# INDEXER_VERSION=main
# WORKLOAD_VERSION=main
# DASHBOARD_VERSION=main
# DASHBOARD_HASURA_VERSION=main

# --- Server: uncomment and fill in ---
# COMPOSE_PROFILES=jenkins,proxy,host-metrics
# SECRETS_SOURCE=pass
# SECRETS_DIR=/run/pouw-secrets
#
# The domain must point to the server's public IP (A record). Without your own
# domain, e.g. jenkins.<ip-with-dashes>.sslip.io works
# JENKINS_HOST=jenkins.example.org
# GRAFANA_HOST=grafana.example.org
# EXPLORER_HOST=explorer.example.org   # explorer and /v1/graphql of Hasura
# JENKINS_URL=https://jenkins.example.org/
# GRAFANA_URL=https://grafana.example.org/
# ACME_EMAIL=name@stuba.sk
#
# Jenkins login via GitHub (local = admin and password from secrets)
# JENKINS_AUTH=github
# GitHub accounts with full rights in Jenkins, comma-separated
# JENKINS_ADMINS=Faustynn
#
# E-mails from Jenkins (failed nightly build) and Alertmanager (alerts). SMTP
# username and password are in pass:
# pass insert -m pouw/smtp/username, pass insert -m pouw/smtp/password
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=jenkins@example.org
# ALERT_EMAIL=name@stuba.sk      # who gets the alerts, comma-separated
#
# Nightly dumps of the indexer database (service backup), kept for 7 days
# BACKUP_DIR=./backups           # a path on the host, outside the Docker volumes
# BACKUP_AT=02:00                # UTC
