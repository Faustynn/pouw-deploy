    {
      "type": "stat",
      "title": "Disk used (fullest)",
      "description": "The fullest real filesystem; per mountpoint below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|nsfs|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|nsfs|fuse.*\"}))",
          "legendFormat": "disk",
          "range": false,
          "instant": true
