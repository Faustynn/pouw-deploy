# Encrypt certificates are issued automatically once the domain points
# to server and ports 80 and 443 are reachable from outside.
# Locally (*.localhost) Caddy uses its own CA.
{
	email {$ACME_EMAIL}
}

{$JENKINS_HOST} {
	encode gzip
	reverse_proxy jenkins:8080
}

# The explorer, Hasura and Grafana by container name: on the server those of
# the dev network share a Docker network with this Caddy (compose.edge.yml),
# where the bare service names exist twice.
{$GRAFANA_HOST} {
	encode gzip
	# Only the explorer may put Grafana into an iframe. allow_embedding drops
	# X-Frame-Options from every page, the login page too.
	header Content-Security-Policy "frame-ancestors 'self' https://{$EXPLORER_HOST}"
	reverse_proxy pouw-grafana-1:3000
}

# The explorer and its API on one host, so the browser needs no CORS. Only
# /v1/graphql of Hasura goes out (reverse_proxy passes the WebSocket of
# subscriptions by itself); /console, /v1/metadata and /v2/query stay inside.
{$EXPLORER_HOST} {
	encode gzip
	handle /v1/graphql {
		reverse_proxy pouw-hasura-1:8080
	}
	# nginx of the explorer passes all of /v1/ to Hasura (pouw-dashboard/web/nginx.conf),
	# so the rest of it is closed here: /v1/metadata, /v1/query, /v1/version, ...
	handle /v1/* {
		respond 404
	}
	handle {
		reverse_proxy pouw-dashboard-1:8080
	}
}

# The dev network (project pouw-dev, scripts/dev-setup.sh): the same, over the
# Docker network of compose.edge.yml. 502 until the dev network runs.
{$GRAFANA_DEV_HOST} {
	encode gzip
	header Content-Security-Policy "frame-ancestors 'self' https://{$EXPLORER_DEV_HOST}"
	reverse_proxy pouw-dev-grafana-1:3000
}

{$EXPLORER_DEV_HOST} {
	encode gzip
	handle /v1/graphql {
		reverse_proxy pouw-dev-hasura-1:8080
	}
	handle /v1/* {
		respond 404
	}
	handle {
		reverse_proxy pouw-dev-dashboard-1:8080
	}
}

# Alertmanager (alerts, silences) behind a login: user ALERTMANAGER_USER,
# password pouw/alertmanager/password in pass. run.sh puts its bcrypt hash into
# ALERTMANAGER_HASH, so neither the password nor its hash is in git.
{$ALERTMANAGER_HOST} {
	encode gzip
	basic_auth {
		{$ALERTMANAGER_USER} {$ALERTMANAGER_HASH}
	}
	reverse_proxy alertmanager:9093
}
